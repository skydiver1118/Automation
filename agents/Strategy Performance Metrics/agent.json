  ],
  "outputs": [
    "reports/soxl_tqqq_rotation_cash_oos_performance.md",
    "reports/soxl_tqqq_rotation_cash_oos_performance_summary_metrics.csv",
    "reports/soxl_tqqq_rotation_cash_oos_performance_annual_return_drawdown.csv",
    "reports/soxl_tqqq_rotation_cash_oos_performance_annual_returns.csv",
    "reports/soxl_tqqq_rotation_cash_oos_performance_annual_drawdowns.csv",
    "reports/soxl_tqqq_rotation_cash_oos_performance_trades.csv",
    "reports/soxl_tqqq_rotation_cash_oos_performance_holding_period_by_outcome.csv",
    "reports/soxl_tqqq_rotation_cash_oos_performance_equity_curves.csv",
    "reports/soxl_tqqq_rotation_cash_oos_performance_drawdown_curves.csv",
    "reports/soxl_tqqq_rotation_cash_oos_performance_curves.png",
